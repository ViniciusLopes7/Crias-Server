[Unit]
Description=Minecraft Server
After=network.target
# Sem restart automatico: OOM/crash exige diagnostico e inicio manual.
# Limite adicional de tentativas rapidas realizadas pelo operador.
StartLimitIntervalSec=300s
StartLimitBurst=3
Conflicts=terraria.service

[Service]
Type=simple
User=${SERVER_USER}
Group=${SERVER_USER}
WorkingDirectory=${SERVER_DIR}
ExecStart=${SERVER_DIR}/start-server.sh
# Prefer SIGINT to give the JVM a chance to shutdown cleanly.
KillSignal=SIGINT
TimeoutStopSec=120
Restart=no
RestartSec=30s
OOMPolicy=stop
LimitNOFILE=65536
LimitNPROC=4096
# MemoryHigh: reclaim gradual antes do limite de emergencia.
MemoryHigh=${MEMORY_HIGH_MB}M
MemoryMax=${MEMORY_MAX_MB}M
# Swap emergencial limitado; nao depende de ZRAM estar habilitada.
MemorySwapMax=512M
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
# JVM pode ser encerrada antes de SSH/tailscaled no OOM global;
# MemoryMax isola falhas do cgroup antes de saturar o host.
OOMScoreAdjust=200

# --- Hardening systemd (itens S6/S7 + checklist 6.2) ---
# Nota: Minecraft roda em JVM (JIT). Por isso:
#   - MemoryDenyWriteExecute=yes NAO e aplicavel (quebra JIT).
#   - SystemCallFilter=@system-service e mantido pois OpenJDK 17+ e compativel.
#   - PrivateUsers=true NAO e aplicavel (pode quebrar bind de portas).
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=yes
LockPersonality=yes
# Remove todas as capabilities — JVM nao precisa de nenhuma.
CapabilityBoundingSet=
AmbientCapabilities=
# Filtra syscalls perigosas (ptrace, module, rawio, etc.)
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=${SERVER_DIR}

[Install]
WantedBy=multi-user.target
