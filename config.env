# ============================================
# Crias-Server Global Configuration (PT-BR)
# ============================================

# Stack to install. Values: minecraft | terraria
SERVER_TYPE=""

# Hardware tier override. Empty = auto-detect; LOW | MID | HIGH = force.
FORCE_HARDWARE_TIER=""

# Global flags
INSTALL_TAILSCALE="true"
APPLY_SYSTEM_TUNING="true"
# host = apply host-wide tuning (sysctl/zram/scheduler/cpupower)
# none = no host tuning (VPS, containers, or pre-optimized hosts)
SYSTEM_TUNING_SCOPE="host"
CLEANUP_OTHER_STACK="true"
# DRY_RUN=true skips destructive ops (pacman/useradd/systemd/cleanup).
DRY_RUN="false"
# NON_INTERACTIVE=true disables prompts and requires SERVER_TYPE set.
NON_INTERACTIVE="false"

# Virtualization auto-detection.
# auto = skip tuning in container/VPS (recommended)
# force = apply tuning even in container/VPS
VIRT_TUNING_BEHAVIOR="auto"

# ============================================
# Hardware tier thresholds
# ============================================
# Edit with care — defaults are conservative.
HW_LOW_TIER_MAX_RAM_MB=3072
HW_LOW_TIER_MAX_CPU_CORES=2
HW_MID_TIER_MAX_RAM_MB=12288
HW_MID_TIER_MAX_CPU_CORES=6

# ============================================
# Minecraft
# ============================================
MINECRAFT_USER="minecraft"
MINECRAFT_SERVER_DIR="/opt/minecraft-server"
MINECRAFT_PORT=25565
# online_mode="true" is the SECURE default (Mojang auth required).
# Set "false" ONLY for trusted offline/LAN tests — anyone can join with any
# nickname in offline mode. NEVER use "false" on internet-exposed servers.
MINECRAFT_ONLINE_MODE="true"
MINECRAFT_VERSION="1.21.11"
MINECRAFT_LOADER="fabric"
MINECRAFT_INSTALL_MODPACK="true"
MINECRAFT_ADRENALINE_VERSION=""
MINECRAFT_INSTALL_QOL_MODS="true"

# QoL mods as CSV "file_name:slug,file_name:slug,...". Defaults for Fabric+Adrenaline.
MINECRAFT_QOL_MODS="chunky:chunky,essential-commands:essential-commands,universal-graves:universal-graves,tabtps:tabtps,styled-chat:styled-chat,polymer:polymer,placeholder-api:placeholder-api"

# Modpack source.
# adrenaline = Adrenaline modpack (default)
# modrinth   = generic modpack via MODPACK_SLUG on Modrinth
# vanilla    = install vanilla loader only (no modpack)
MINECRAFT_MODPACK_SOURCE="adrenaline"
MINECRAFT_MODPACK_SLUG="adrenaline"

# Supply chain checksums (optional). When set (64 hex), installer verifies download.
# QoL mods use MOD_<NAME>_SHA256, e.g. MOD_CHUNKY_SHA256, MOD_ESSENTIAL_COMMANDS_SHA256.
MRPACK_SHA256=""

# Pinned mrpack-install version + checksum. Update both together.
# SHA256 of mrpack-install_0.21.0-beta_linux_amd64.tar.gz:
#   718e2f9f7337cddd8992641b22e704786a5e70e744e661d51aa3494f7ddfd9d2
MRPACK_INSTALL_VERSION="v0.21.0-beta"
MRPACK_INSTALL_SHA256="718e2f9f7337cddd8992641b22e704786a5e70e744e661d51aa3494f7ddfd9d2"

# ============================================
# Terraria (Vanilla Dedicated Server)
# ============================================
TERRARIA_USER="terraria"
TERRARIA_SERVER_DIR="/opt/terraria-server"
TERRARIA_PORT=7777
TERRARIA_WORLD_NAME="world"
TERRARIA_MOTD="Server dos Crias"

# Official dedicated server package URL. Adjust if the official link changes.
TERRARIA_DOWNLOAD_URL="https://terraria.org/api/download/pc-dedicated-server/terraria-server-1456.zip"

# Required supply chain checksum (64 hex).
# SHA256 of terraria-server-1456.zip:
#   d75c455ac217fd3434448c8f8251c1347f0875a85c438589dc71b557777e9155
TERRARIA_SHA256="d75c455ac217fd3434448c8f8251c1347f0875a85c438589dc71b557777e9155"

# ============================================
# Backup
# ============================================
# Retention in days (default: 7; tier overrides: LOW=5, HIGH=10).
BACKUP_RETENTION_DAYS="7"
# zstd compression level (-1 to -19; default -3; more negative = faster).
BACKUP_ZSTD_LEVEL="-3"

# Optional remote backup via rsync after local .tar.zst is created.
# BACKUP_REMOTE_PATH="user@host:/path/to/backups/"
BACKUP_REMOTE_PATH=""

# Optional webhook for backup success/failure notifications (JSON POST).
# BACKUP_NOTIFY_WEBHOOK="https://discord.com/api/webhooks/..."
BACKUP_NOTIFY_WEBHOOK=""

# ============================================
# Remote control agent (crias-agent)
# ============================================
# INSTALL_AGENT=true installs the Go agent during install.sh.
# Default: prompt interactively. Auth token is auto-generated.
INSTALL_AGENT=""

# Optional SHA256 (64 hex) of crias-agent-linux-amd64.
# When empty, installer extracts `digest` from the GitHub API asset
# (sha256:<hex> published automatically for assets created after 2023).
# Set manually for explicit pinning (e.g., air-gapped or audit scenarios).
CRIAS_AGENT_SHA256=""
