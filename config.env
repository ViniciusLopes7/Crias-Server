# Crias-Server Global Configuration (PT-BR)

# Stack to install. Values: minecraft | terraria
SERVER_TYPE=""

# Hardware tier override. Empty = auto-detect; LOW | MID | HIGH = force.
FORCE_HARDWARE_TIER=""

# Global flags
INSTALL_TAILSCALE="true"
APPLY_SYSTEM_TUNING="true"
# host = apply host-wide tuning (sysctl/zram/scheduler/cpupower)
# none = no host tuning (VPS, containers, or pre-optimized hosts)
SYSTEM_TUNING_SCOPE="host"
CLEANUP_OTHER_STACK="true"
# DRY_RUN=true skips destructive ops (pacman/useradd/systemd/cleanup).
DRY_RUN="false"
# NON_INTERACTIVE=true disables prompts and requires SERVER_TYPE set.
NON_INTERACTIVE="false"

# Virtualization auto-detection.
# auto = skip tuning in container/VPS (recommended)
# force = apply tuning even in container/VPS
VIRT_TUNING_BEHAVIOR="auto"

# Hardware tier thresholds
# Edit with care — defaults are conservative.
HW_LOW_TIER_MAX_RAM_MB=3072
HW_LOW_TIER_MAX_CPU_CORES=2
HW_MID_TIER_MAX_RAM_MB=12288
HW_MID_TIER_MAX_CPU_CORES=6

# ============================================
# Minecraft
# ============================================
MINECRAFT_USER="minecraft"
MINECRAFT_SERVER_DIR="/opt/minecraft-server"
MINECRAFT_PORT=25565
# online_mode="true" is the SECURE default (Mojang auth required).
# Set "false" ONLY for trusted offline/LAN tests — anyone can join with any
# nickname in offline mode. NEVER use "false" on internet-exposed servers.
MINECRAFT_ONLINE_MODE="true"
# MOTD do Minecraft (códigos § + \\n para nova linha). Ver tui_help "motd" para gerador.
MINECRAFT_MOTD="§6§l🏰 REINO DOS CRIAS 🏰\\n§eAdrenaline + QoL §7| §aA resenha nunca morre...§r"
# Versao do Minecraft. Em modo interativo, o instalador busca a lista
# dinamicamente via o manifest do loader selecionado (Mojang/Fabric/Quilt/
# NeoForge/Forge) e oferece selecao via TUI (gum filter). Aqui fica o
# default usado em NON_INTERACTIVE ou se a busca falhar.
MINECRAFT_VERSION="26.3"
# Loader: fabric | quilt | vanilla | forge | neoforge
# (paper foi removido em v1.2.0 — nao suportado pelo fluxo de modpack .mrpack)
MINECRAFT_LOADER="fabric"
MINECRAFT_INSTALL_MODPACK="true"
# Versao do modpack (ex.: versao do Adrenaline). Em modo interativo, o
# instalador busca as versoes compativeis com o loader+MC selecionado via
# API do Modrinth e oferece selecao. Vazio = mrpack-install usa a mais recente.
# Versao do modpack (tag do Modrinth). Nome legacy "ADRENALINE": a variavel
# vale para QUALQUER fonte (adrenaline/modrinth) — e a versao escolhida no
# wizard para o modpack selecionado. Vazio = mais recente.
MINECRAFT_ADRENALINE_VERSION=""
MINECRAFT_INSTALL_QOL_MODS="true"

# QoL mods as CSV "file_name:slug,file_name:slug,...". Defaults for Fabric+Adrenaline.
MINECRAFT_QOL_MODS="chunky:chunky,essential-commands:essential-commands,universal-graves:universal-graves,tabtps:tabtps,styled-chat:styled-chat,polymer:polymer,placeholder-api:placeholder-api"

# Individual user mods (CSV of Modrinth slugs) applied ON TOP of the
# modpack/QoL. Unlike QoL, these are NOT skipped when mods/ already has
# modpack files. E.g.: "sodium,lithium,ferrite-core"
MINECRAFT_EXTRA_MODS=""

# Modpack source.
# adrenaline = Adrenaline modpack (default)
# modrinth   = generic modpack via MODPACK_SLUG on Modrinth (incl. top-10 e busca)
# arquivo    = arquivo .mrpack local, inclusive em pendrive montado
# link       = URL HTTPS direta para um arquivo .mrpack
# vanilla    = install vanilla loader only (no modpack)
# Em modo interativo, o instalador oferece um seletor TUI com top-10 do
# Modrinth, busca por nome, vanilla, ou slug manual. O valor aqui e o default.
MINECRAFT_MODPACK_SOURCE="adrenaline"
MINECRAFT_MODPACK_SLUG="adrenaline"
# Caminho absoluto ou link HTTPS direto conforme a fonte escolhida.
MINECRAFT_MODPACK_FILE=""
MINECRAFT_MODPACK_URL=""
# Server icon (optional). URL de uma imagem PNG 64x64 para server-icon.png.
MINECRAFT_SERVER_ICON_URL=""

# mrpack-install version pin.
# v0.23.0 = primeira stable com subcomando `server` (downloads staged,
# --server-file p/ todo loader, servers Forge/NeoForge). O installer usa:
#   sem modpack:  mrpack-install server <loader> --minecraft-version <v> ...
#   com modpack:  mrpack-install <slug> [versao] ...
# O pacote do pacman só é usado se a versão BATER com este pin (EXP-41).
MRPACK_INSTALL_VERSION="v0.23.0"

# (CR-17) Modo strict de mods: "true" transforma mods pendentes (download
# falhou / incompatível) em FALHA da instalação. Default "false" =
# best-effort com relatório de pendências no final.
MINECRAFT_MODS_STRICT="false"

# ============================================
# Terraria (Vanilla Dedicated Server)
# ============================================
TERRARIA_USER="terraria"
TERRARIA_SERVER_DIR="/opt/terraria-server"
TERRARIA_PORT=7777
TERRARIA_WORLD_NAME="world"
TERRARIA_MOTD="Server dos Crias"

# Official dedicated server package URL. Adjust if the official link changes.
# 1458 = build mais recente em terraria.org (auditado 2026-11; 1459+ = 404).
TERRARIA_DOWNLOAD_URL="https://terraria.org/api/download/pc-dedicated-server/terraria-server-1458.zip"

# tModLoader (implementado em v1.2.1). Substitui o servidor vanilla do Terraria
# pelo tModLoader quando "true". Mesma porta (7777), mesmo diretorio, mesma
# service unit. Ver docs/tmodloader.md para detalhes (catálogo, SteamCMD, etc.).
TERRARIA_USE_TMODLOADER="false"
# Versao do tModLoader (tag do GitHub, ex.: v2026.09.3.1). Vazio = busca
# dinamica via GitHub Releases API no install.sh interativo.
TERRARIA_TMODLOADER_VERSION=""
# Mods do tModLoader (CSV de Workshop IDs do Steam, ex.:
# "2824688072,2909886416"). Vazio = sem mods. O install.sh interativo
# oferece um seletor TUI com catálogo curado (Calamity, Thorium, etc.).
# Requer steamcmd instalado para download automatico (AUR: steamcmd).
TERRARIA_TMODLOADER_MODS=""
# (CR-17) Modo strict tML: workshop IDs pendentes falham a instalação.
TERRARIA_MODS_STRICT="false"
# (CR-26) Timeout do steamcmd em segundos (downloads grandes; 0 = sem limite
# NÃO é mais permitido — o padrão 3600 evita installer pendurado para sempre).
TML_STEAMCMD_TIMEOUT="3600"

# ============================================
# Backup
# ============================================
# (CR-13) Retenção em dias. VAZIO = automático por tier (LOW=5, MID=7,
# HIGH=10). Um valor explícito TEM PRIORIDADE sobre o auto-tuning e é
# persistido no runtime.env de cada stack.
BACKUP_RETENTION_DAYS=""
# (CR-13) Nível de compressão zstd (-1 a -19; mais negativo = mais rápido).
# VAZIO = automático por tipo de disco (SSD=-1, HDD=-3).
BACKUP_ZSTD_LEVEL=""

# (CR-06) Backup consistente obrigatório (apenas Minecraft): "true" ABORTA o
# backup quando não há RCON/mcrcon disponíveis — sem save-off/save-all o
# arquivo pode ser inconsistente. Configure RCON e mcrcon; "false" permite
# explicitamente backup best-effort, que pode nao ser restauravel.
BACKUP_REQUIRE_CONSISTENT="true"

# Optional remote backup via rsync after local .tar.zst is created.
# BACKUP_REMOTE_PATH="user@host:/path/to/backups/"
BACKUP_REMOTE_PATH=""

# Optional webhook for backup success/failure notifications (JSON POST).
# BACKUP_NOTIFY_WEBHOOK="https://discord.com/api/webhooks/..."
BACKUP_NOTIFY_WEBHOOK=""

# Incluir mods/ (Minecraft) e Mods/ (Terraria tML) nos backups. Mundos e
# config entram SEMPRE; isto controla apenas os jars (re-baixaveis).
# Desative se os backups ficarem grandes demais.
BACKUP_INCLUDE_MODS="true"

# ============================================
# Remote control agent (crias-agent)
# ============================================
# INSTALL_AGENT=true installs the Go agent during install.sh.
# Default: prompt interactively. Auth token is auto-generated.
# (EXP-44) Reinstalar o agente NÃO roda o token por padrão — o token atual
# em /etc/crias/agent.yaml é reutilizado para não invalidar o bot conectado.
# Rotação explícita: AGENT_ROTATE_TOKEN=true ./install.sh
INSTALL_AGENT=""

# ============================================
# Monitoring tools (v1.3.0 / F5)
# ============================================
# INSTALL_MONITOR_TOOLS=true instala btop + ncdu no host (pacman -S --needed).
# Pré-instalados na ISO para o live; esta flag instala no host pós-archinstall
# para que o subcomando `monitor` dos managers funcione após reboot.
# Default: prompt interactively (default N).
INSTALL_MONITOR_TOOLS=""

# ============================================
# SSH access (v1.2.0)
# ============================================
# INSTALL_SSH=true instala openssh no host, habilita sshd.service, cria o
# usuario 'crias' com sudo (senha pedida interativamente) e configura
# PermitRootLogin no (hardening). Default: prompt interactively (default N).
# No live ISO o sshd NAO sobe sozinho — este passo configura apenas o host
# instalado apos o install.sh rodar.
INSTALL_SSH=""
# SSH_USER define o nome do usuário criado para acesso SSH (default: crias).
SSH_USER=""
